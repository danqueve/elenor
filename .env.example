APP_NAME=Elenor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://elenor.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_TIMEZONE=America/Argentina/Tucuman

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8. En WAMP escucha en el 3306 (MariaDB usa el 3307).
# Hay que crear las bases "elenor" y "elenor_test" (ver README).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elenor
DB_USERNAME=root
DB_PASSWORD=
# Tucumán no tiene horario de verano: UTC-3 todo el año.
DB_TIMEZONE=-03:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@elenor.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Tienda: moneda y datos de contacto que se muestran en el sitio.
# Los valores de ejemplo son ficticios: reemplazarlos por los reales.
SHOP_CURRENCY=ARS
SHOP_ADDRESS="Calle Falsa 123, San Miguel de Tucumán, Tucumán"
SHOP_PHONE="+54 381 000-0000"
# Solo dígitos, con código de país (54) y el 9 de celular.
SHOP_WHATSAPP=5493810000000
SHOP_EMAIL=ventas@elenor.test
SHOP_HOURS="Lunes a viernes de 8 a 13 y de 16 a 20 · Sábados de 8 a 13"
# Email de Google de quien administra la tienda: el seeder crea esa cuenta como admin.
SHOP_ADMIN_EMAIL=admin@elenor.test

# Login con Google. Guía paso a paso en el README, sección "Login con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que ser IGUAL a una "URI de redireccionamiento autorizada" de Google.
# Google no acepta elenor.test: en local se usa localhost (php artisan serve).
# En producción: https://TU-DOMINIO/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
